<Window x:Class="SmaetRec.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SmaetRec.Services"
        Title="SMAET REC" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootLayout" Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="70"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===== Title bar ===== -->
    <Grid Grid.Row="0" Margin="20,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Logo -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="38" Height="38">
          <Border CornerRadius="12" Background="{StaticResource AccentGradient}"/>
          <Ellipse Width="22" Height="22" Stroke="#B3FFFFFF" StrokeThickness="1.3"/>
          <Ellipse Width="9" Height="9" Fill="White"/>
        </Grid>
        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}">
            <Run Text="SMAET"/> <Run Text="REC" Foreground="#FF7B87"/>
          </TextBlock>
          <TextBlock Text="{Binding [Tagline], Source={x:Static loc:Loc.I}}" FontSize="10.5"
                     Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>

      <!-- Status -->
      <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#0FFFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
              CornerRadius="16" Padding="13,7">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Amber}" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="{Binding [Status.Preparing], Source={x:Static loc:Loc.I}}"
                     FontSize="12" Foreground="#D6DCE8"/>
        </StackPanel>
      </Border>

      <!-- Actions -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="OpenProjectButton" Style="{StaticResource IconButton}" Width="38" Height="36"
                ToolTip="{Binding [Settings], Source={x:Static loc:Loc.I}}" Click="OpenProject_Click">
          <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="38" Height="36"
                ToolTip="{Binding [Settings], Source={x:Static loc:Loc.I}}" Click="Settings_Click">
          <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
        </Button>
        <Border Width="1" Height="22" Background="{StaticResource Stroke}" Margin="8,0"/>
        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="تصغير">
          <Path Data="M5,12 H19" Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="24" Height="24" Stretch="Uniform"/>
        </Button>
        <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="تكبير">
          <Path x:Name="MaxIcon" Data="M6,6 H18 V18 H6 Z" Stroke="{StaticResource Text}" StrokeThickness="1.3" Width="22" Height="22" Stretch="Uniform"/>
        </Button>
        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="إغلاق">
          <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== Stage ===== -->
    <Border Grid.Row="1" x:Name="StageFrame" Margin="20,0,20,20" CornerRadius="22"
            Background="#0C0F14" BorderBrush="#14FFFFFF" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <Grid x:Name="StagePlaceholder">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
            <Border Width="74" Height="74" CornerRadius="22" Background="#12FFFFFF" HorizontalAlignment="Center">
              <Path Data="M3,4 H21 A1,1 0 0 1 22,5 V16 A1,1 0 0 1 21,17 H3 A1,1 0 0 1 2,16 V5 A1,1 0 0 1 3,4 M8,21 H16 M12,17 V21"
                    Stroke="{StaticResource TextDim}" StrokeThickness="1.3" Width="34" Height="34" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding [Hint.NoScreen], Source={x:Static loc:Loc.I}}"
                       Foreground="{StaticResource TextDim}" FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- Bottom dock -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="#F0171B23" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="26"
                Padding="10,8">
          <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
          </Border.Effect>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ConnectButton" Style="{StaticResource DockButton}" Click="Connect_Click">
              <StackPanel>
                <Path Data="M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 M10,5 H14 M11,19 H13"
                      Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Action.Connect], Source={x:Static loc:Loc.I}}" FontSize="10.5"
                           Foreground="{StaticResource TextDim}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="ScreenButton" Style="{StaticResource DockButton}" Click="Screen_Click">
              <StackPanel>
                <Path Data="M3,4 H21 A1,1 0 0 1 22,5 V16 A1,1 0 0 1 21,17 H3 A1,1 0 0 1 2,16 V5 A1,1 0 0 1 3,4 M8,21 H16 M12,17 V21"
                      Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScreenLabel" Text="{Binding [Action.Screen], Source={x:Static loc:Loc.I}}" FontSize="10.5"
                           Foreground="{StaticResource TextDim}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="DrawButton" Style="{StaticResource DockButton}" Click="Draw_Click">
              <StackPanel>
                <Path Data="M4,20 L5,15 L16,4 A2.1,2.1 0 0 1 19,4 L20,5 A2.1,2.1 0 0 1 20,8 L9,19 Z M14,6 L18,10"
                      Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Action.Draw], Source={x:Static loc:Loc.I}}" FontSize="10.5"
                           Foreground="{StaticResource TextDim}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="EffectsButton" Style="{StaticResource DockButton}" Click="Effects_Click">
              <StackPanel>
                <Path Data="M12,2 L13.8,7.2 L19,9 L13.8,10.8 L12,16 L10.2,10.8 L5,9 L10.2,7.2 Z M18.5,15 L19.5,18 L22.5,19 L19.5,20 L18.5,23 L17.5,20 L14.5,19 L17.5,18 Z"
                      Fill="{StaticResource Text}" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Action.Effects], Source={x:Static loc:Loc.I}}" FontSize="10.5"
                           Foreground="{StaticResource TextDim}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Border Width="1" Height="38" Background="#14FFFFFF" Margin="6,0" VerticalAlignment="Center"/>

            <Button x:Name="RecordButton" Style="{StaticResource RecordButton}" Click="Record_Click"/>
            <Button x:Name="StopButton" Style="{StaticResource StopButton}" Click="Stop_Click"/>
          </StackPanel>
        </Border>

        <!-- Recording timer -->
        <Border x:Name="TimerPill" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                Background="#E612161D" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="15"
                Padding="12,7" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
            <TextBlock x:Name="TimerText" Text="00:00" FontSize="12.5" FontFamily="Consolas, Segoe UI"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
