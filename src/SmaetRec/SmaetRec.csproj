<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SmaetRec</AssemblyName>
    <RootNamespace>SmaetRec</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>moha700m</Authors>
    <Product>SMAET REC</Product>
    <Company>SMAET</Company>
    <Copyright>GPL-3.0</Copyright>
    <NeutralLanguage>ar</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\SmaetRec.Native\bin\SmaetRec.FairPlay.dll" Link="SmaetRec.FairPlay.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\SmaetRec.Native\bin\SmaetRec.FairPlay.dll')" />
    <None Include="..\..\installer\SmaetRec.iss" Link="installer\SmaetRec.iss" />
  </ItemGroup>

</Project>
