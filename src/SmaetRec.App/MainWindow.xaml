<Window x:Class="SmaetRec.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SmaetRec.Core;assembly=SmaetRec.Core"
        xmlns:local="clr-namespace:SmaetRec.App"
        Title="SMAET REC" Width="1320" Height="860" MinWidth="1100" MinHeight="660"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="104"/>
        </Grid.RowDefinitions>

        <!-- Top: logo, status, settings -->
        <Border Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="SMAET REC" FontSize="19" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PhoneDot" Width="9" Height="9" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PhoneStatus" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ScreenDot" Width="9" Height="9" Fill="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScreenStatus" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RecPill" Style="{StaticResource Pill}" Background="#3A1512" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecTime" Text="00:00" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                            <TextBlock x:Name="RecSound" Margin="12,0,0,0" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Toast" Style="{StaticResource Pill}" Background="#12301C" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastText" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="ToastButton" Style="{StaticResource PlainButton}" Height="26" Padding="10,0" Margin="10,0,0,0" FontSize="12.5" Click="ToastButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Grid.Column="2" x:Name="BtnSettings" Style="{StaticResource ToolButton}" Height="40" MinWidth="44" local:Ui.Glyph="&#xE713;"
                        ToolTip="{Binding [Settings], Source={x:Static core:Loc.Instance}}" Click="Settings_Click"/>
            </Grid>
        </Border>

        <!-- Centre: live preview -->
        <Border Grid.Row="1" Background="{StaticResource WindowBrush}">
            <local:PreviewHost x:Name="Preview"/>
        </Border>

        <!-- Context tools: only the row for the current mode is shown -->
        <Border Grid.Row="2" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                <Grid VerticalAlignment="Center" Margin="12,0">
                    <StackPanel x:Name="ArrangeBar" Orientation="Horizontal">
                    <Button x:Name="BtnSide" Style="{StaticResource ToolButton}" local:Ui.Key="SideBySide" local:Ui.Geometry="M2,6 H13 V18 H2 Z M16,4 H22 V20 H16 Z" Content="{Binding [SideBySide], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [SideBySide], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    <Button x:Name="BtnPip" Style="{StaticResource ToolButton}" local:Ui.Key="Pip" local:Ui.Geometry="M2,5 H22 V19 H2 Z M15,9 H20 V17 H15 Z" Content="{Binding [PhoneOverScreen], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [PhoneOverScreen], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    <Button x:Name="BtnReset" Style="{StaticResource ToolButton}" local:Ui.Key="Reset" local:Ui.Glyph="&#xE72C;" Content="{Binding [ResetLayout], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [ResetLayout], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <Button x:Name="BtnRotate" Style="{StaticResource ToolButton}" local:Ui.Key="Rotate" local:Ui.Glyph="&#xE7AD;" Content="{Binding [Rotate], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Rotate], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    <Button x:Name="BtnOrient" Style="{StaticResource ToolButton}" local:Ui.Key="Orient" local:Ui.Geometry="M4,2 H11 V15 H4 Z M9,18 H22 V22 H9 Z" Content="{Binding [Orientation], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Orientation], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <ToggleButton x:Name="BtnHidePhone" Style="{StaticResource ToolToggle}" local:Ui.Key="HidePhone" local:Ui.Glyph="&#xE8EA;" Content="{Binding [HidePhone], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [HidePhone], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    <ToggleButton x:Name="BtnHideScreen" Style="{StaticResource ToolToggle}" local:Ui.Key="HideScreen" local:Ui.Glyph="&#xE7F4;" Content="{Binding [HideScreen], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [HideScreen], Source={x:Static core:Loc.Instance}}" Click="Arrange_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="DrawBar" Orientation="Horizontal" Visibility="Collapsed">
                    <ToggleButton x:Name="ToolPen" Style="{StaticResource ToolToggle}" local:Ui.Key="Pen" local:Ui.Glyph="&#xE70F;" Content="{Binding [Pen], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Pen], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolHighlighter" Style="{StaticResource ToolToggle}" local:Ui.Key="Highlighter" local:Ui.Glyph="&#xE7E6;" Content="{Binding [Highlighter], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Highlighter], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolArrow" Style="{StaticResource ToolToggle}" local:Ui.Key="Arrow" local:Ui.Geometry="M4,20 L20,4 M10,4 L20,4 L20,14" Content="{Binding [Arrow], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Arrow], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolEllipse" Style="{StaticResource ToolToggle}" local:Ui.Key="Ellipse" local:Ui.Geometry="M12,3 A9,9 0 1 1 11.99,3 Z" Content="{Binding [Circle], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Circle], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolRectangle" Style="{StaticResource ToolToggle}" local:Ui.Key="Rectangle" local:Ui.Geometry="M3,6 H21 V18 H3 Z" Content="{Binding [Rectangle], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Rectangle], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolText" Style="{StaticResource ToolToggle}" local:Ui.Key="Text" local:Ui.Glyph="&#xE8D2;" Content="{Binding [Text], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Text], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolBlur" Style="{StaticResource ToolToggle}" local:Ui.Key="Blur" local:Ui.Geometry="M4,4 h3 v3 h-3 Z M10.5,4 h3 v3 h-3 Z M17,4 h3 v3 h-3 Z M4,10.5 h3 v3 h-3 Z M10.5,10.5 h3 v3 h-3 Z M17,10.5 h3 v3 h-3 Z M4,17 h3 v3 h-3 Z M10.5,17 h3 v3 h-3 Z M17,17 h3 v3 h-3 Z" Content="{Binding [Blur], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Blur], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <ToggleButton x:Name="ToolEraser" Style="{StaticResource ToolToggle}" local:Ui.Key="Eraser" local:Ui.Glyph="&#xE75C;" Content="{Binding [Eraser], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Eraser], Source={x:Static core:Loc.Instance}}" Click="Tool_Click"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <ToggleButton x:Name="ToolSpotlight" Style="{StaticResource ToolToggle}" local:Ui.Key="Spotlight" local:Ui.Geometry="M12,7 A5,5 0 1 1 11.99,7 Z M12,1 V3.5 M12,20.5 V23 M1,12 H3.5 M20.5,12 H23" Content="{Binding [Spotlight], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Spotlight], Source={x:Static core:Loc.Instance}}" Click="Pointer_Click"/>
                    <ToggleButton x:Name="ToolMagnifier" Style="{StaticResource ToolToggle}" local:Ui.Key="Magnifier" local:Ui.Geometry="M10,3 A7,7 0 1 1 9.99,3 Z M15,15 L21,21" Content="{Binding [Magnifier], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Magnifier], Source={x:Static core:Loc.Instance}}" Click="Pointer_Click"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolButton}" local:Ui.Key="Undo" local:Ui.Glyph="&#xE7A7;" Content="{Binding [Undo], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Undo], Source={x:Static core:Loc.Instance}}" Click="History_Click"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolButton}" local:Ui.Key="Redo" local:Ui.Glyph="&#xE7A6;" Content="{Binding [Redo], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Redo], Source={x:Static core:Loc.Instance}}" Click="History_Click"/>
                    <Button x:Name="BtnClear" Style="{StaticResource ToolButton}" local:Ui.Key="Clear" local:Ui.Glyph="&#xE74D;" Content="{Binding [ClearAll], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [ClearAll], Source={x:Static core:Loc.Instance}}" Click="History_Click"/>
                        <StackPanel x:Name="StylePanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Style="{StaticResource Separator}"/>
                            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="EffectsBar" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="BtnZoomIn" Style="{StaticResource ToolButton}" local:Ui.Key="ZoomIn" local:Ui.Glyph="&#xE8A3;" Content="{Binding [ZoomIn], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [ZoomIn], Source={x:Static core:Loc.Instance}}" Click="Zoom_Click"/>
                    <Button x:Name="BtnZoomOut" Style="{StaticResource ToolButton}" local:Ui.Key="ZoomOut" local:Ui.Glyph="&#xE71F;" Content="{Binding [ZoomOut], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [ZoomOut], Source={x:Static core:Loc.Instance}}" Click="Zoom_Click"/>
                    <Button x:Name="BtnZoomReset" Style="{StaticResource ToolButton}" local:Ui.Key="ZoomReset" local:Ui.Geometry="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15" Content="{Binding [ZoomReset], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [ZoomReset], Source={x:Static core:Loc.Instance}}" Click="Zoom_Click"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <ToggleButton x:Name="FxCursor" Style="{StaticResource ToolToggle}" local:Ui.Key="Cursor" local:Ui.Geometry="M6,3 L6,19 L10,15 L13,21 L15,20 L12,14 L18,14 Z" Content="{Binding [CursorHighlight], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [CursorHighlight], Source={x:Static core:Loc.Instance}}" Click="Effect_Click"/>
                    <ToggleButton x:Name="FxClicks" Style="{StaticResource ToolToggle}" local:Ui.Key="Clicks" local:Ui.Geometry="M12,9 A3,3 0 1 1 11.99,9 Z M12,4 A8,8 0 1 1 11.99,4 Z" Content="{Binding [ClickEffect], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [ClickEffect], Source={x:Static core:Loc.Instance}}" Click="Effect_Click"/>
                    <ToggleButton x:Name="FxShadows" Style="{StaticResource ToolToggle}" local:Ui.Key="Shadows" local:Ui.Geometry="M4,4 H16 V16 H4 Z M8,20 H20 V8" Content="{Binding [Shadows], Source={x:Static core:Loc.Instance}}" ToolTip="{Binding [Shadows], Source={x:Static core:Loc.Instance}}" Click="Effect_Click"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                        <TextBlock Text="{Binding [Background], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <StackPanel x:Name="BackgroundPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Bottom: the six main actions -->
        <Border Grid.Row="3" Background="{StaticResource BarBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnPhone" Style="{StaticResource BigButton}" local:Ui.Glyph="&#xE8EA;" Content="{Binding [ConnectPhone], Source={x:Static core:Loc.Instance}}" Click="Phone_Click"/>
                <Button x:Name="BtnScreen" Style="{StaticResource BigButton}" local:Ui.Glyph="&#xE7F4;" Content="{Binding [ShowScreen], Source={x:Static core:Loc.Instance}}" Click="Screen_Click"/>
                <ToggleButton x:Name="BtnDraw" Style="{StaticResource BigToggle}" local:Ui.Glyph="&#xE70F;" Content="{Binding [Draw], Source={x:Static core:Loc.Instance}}" Click="Mode_Click"/>
                <ToggleButton x:Name="BtnEffects" Style="{StaticResource BigToggle}" local:Ui.Geometry="M12,2 L14,9 L21,12 L14,15 L12,22 L10,15 L3,12 L10,9 Z" Content="{Binding [Effects], Source={x:Static core:Loc.Instance}}" Click="Mode_Click"/>
                <Rectangle Style="{StaticResource Separator}" Height="56" Margin="14,0"/>
                <Button x:Name="BtnRecord" Style="{StaticResource BigButton}" MinWidth="150" Content="{Binding [Record], Source={x:Static core:Loc.Instance}}" Click="Record_Click" FontWeight="SemiBold">
                    <local:Ui.Icon><Ellipse Width="28" Height="28" Fill="{StaticResource RedBrush}"/></local:Ui.Icon>
                </Button>
                <Button x:Name="BtnStop" Style="{StaticResource BigButton}" MinWidth="150" Content="{Binding [Stop], Source={x:Static core:Loc.Instance}}" Click="Stop_Click" IsEnabled="False" FontWeight="SemiBold">
                    <local:Ui.Icon><Rectangle Width="24" Height="24" RadiusX="5" RadiusY="5" Fill="{StaticResource TextBrush}"/></local:Ui.Icon>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
