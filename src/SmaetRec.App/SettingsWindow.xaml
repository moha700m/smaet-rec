<Window x:Class="SmaetRec.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SmaetRec.Core;assembly=SmaetRec.Core"
        xmlns:local="clr-namespace:SmaetRec.App"
        Title="{Binding [Settings], Source={x:Static core:Loc.Instance}}" Width="640" SizeToContent="Height">
    <StackPanel Margin="26">
        <TextBlock Text="{Binding [Settings], Source={x:Static core:Loc.Instance}}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Language], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="LangAr" GroupName="lang" Content="العربية" Checked="Changed"/><RadioButton x:Name="LangEn" GroupName="lang" Content="English" Checked="Changed"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Quality], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="Q720" GroupName="q" Content="720p" Checked="Changed"/><RadioButton x:Name="Q1080" GroupName="q" Content="1080p" Checked="Changed"/><RadioButton x:Name="Q4K" GroupName="q" Content="4K" Checked="Changed"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Smoothness], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="Fps30" GroupName="fps" Content="{Binding [Fps30], Source={x:Static core:Loc.Instance}}" Checked="Changed"/><RadioButton x:Name="Fps60" GroupName="fps" Content="{Binding [Fps60], Source={x:Static core:Loc.Instance}}" Checked="Changed"/>
            </StackPanel>
        </Grid>
        <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,2,0,14"/>
        <CheckBox x:Name="Mic" Content="{Binding [Microphone], Source={x:Static core:Loc.Instance}}" Click="Changed"/>
        <CheckBox x:Name="SystemAudio" Content="{Binding [SystemAudio], Source={x:Static core:Loc.Instance}}" Click="Changed"/>
        <TextBlock Text="{Binding [PhoneAudioNote], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" FontSize="12.5" Margin="0,4,0,14"/>
        <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,2,0,14"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [SaveFolder], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FolderText" MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,8,0"/><Button Style="{StaticResource PlainButton}" Height="32" Content="{Binding [Change], Source={x:Static core:Loc.Instance}}" Click="ChangeFolder_Click"/><Button Style="{StaticResource PlainButton}" Height="32" Content="{Binding [OpenFolder], Source={x:Static core:Loc.Instance}}" Click="OpenFolder_Click"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [PhoneName], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PhoneName" Width="240" MaxLength="40" LostFocus="PhoneName_LostFocus"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Project], Source={x:Static core:Loc.Instance}}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PlainButton}" Height="32" Content="{Binding [SaveProject], Source={x:Static core:Loc.Instance}}" Click="SaveProject_Click"/><Button Style="{StaticResource PlainButton}" Height="32" Content="{Binding [OpenProject], Source={x:Static core:Loc.Instance}}" Click="OpenProject_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Message" Foreground="{StaticResource GreenBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>
        <Button Style="{StaticResource AccentButton}" Content="{Binding [Close], Source={x:Static core:Loc.Instance}}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Click="Close_Click"/>
    </StackPanel>
</Window>
